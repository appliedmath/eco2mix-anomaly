# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is ignored by Git: never commit real secrets.

# MLflow tracking server (inside docker compose)
MLFLOW_TRACKING_URI=http://mlflow:5000

# API (Phase 3): key required on endpoints that start jobs
API_KEY=change-me

# DVC remote on DagsHub: not read by the code. Put the token into DVC with
# `dvc remote modify dagshub --local password ...` (see README).
DAGSHUB_USER=your-dagshub-username
DAGSHUB_TOKEN=your-dagshub-token

# ---------- Airflow (Phase 3) ----------
# Absolute path of this project folder ON YOUR MACHINE (run: pwd).
# The DAG tasks mount data/ and models/ from here.
HOST_PROJECT_DIR=/home/your-user/projects/eco2mix-anomaly
# Your user id (run: id -u) so Airflow writes its logs as you
AIRFLOW_UID=1000
# Group of the Docker socket (run: stat -L -c %g /var/run/docker.sock)
DOCKER_GID=0
# Login for the Airflow UI and REST API (choose your own)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Airflow's own Postgres database
AIRFLOW_DB_PASSWORD=change-me
# Random keys, generate each with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me
